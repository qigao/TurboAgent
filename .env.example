# Copy to .env and use absolute, forward-slash paths for the current host.
# Praktor's dotenv reader treats values literally: do not use $VAR or ${VAR}.
# Windows examples below; Linux/macOS equivalents are documented in cmake/BUILD.md.
VSDEVCMD_BAT=C:/Program Files/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
PKG_ROOT=C:/projects/cpp/external/pkgs/turboagent-sdk-20261010
VCPKG_ROOT=C:/tools/vcpkg
VCPKG_CACHE_REPOSITORY_ROOT=C:/Users/your-user/AppData/Local/qigao/vcpkg-cache
VCPKG_BINARY_SOURCES=clear;default,readwrite;nugettimeout,1800;nugetconfig,C:/projects/cpp/turbonet/TurboAgent/cmake/vcpkg-cache.nuget.config,read
# Qigao.Re2c.Binary restored from qigao/vcpkg-cache; use the resolved package version.
RE2C_ROOT=C:/Users/your-user/.nuget/packages/qigao.re2c.binary/4.6.4/tools/windows-x64
SDK_RESTORE_ROOT=C:/projects/cpp/turbonet/TurboAgent/build/restored-sdks
# SDK restoration on Windows uses Git Bash, not the WSL bash launcher.
BASH_EXECUTABLE=C:/Program Files/Git/bin/bash.exe
CMAKE_BUILD_PARALLEL_LEVEL=2

# Required only for Android; keep the target SDK separate from host tools.
# ANDROID_NDK_HOME=C:/Users/your-user/AppData/Local/Android/Sdk/ndk/28.2.13676358
# TURBOAGENT_HOST_IDLC=C:/path/to/windows-host-sdk/bin/salts-idlc.exe
# TURBOAGENT_HOST_SALTS_ROOT=C:/path/to/windows-host-sdk

# Required by the shared read-only NuGet feed. Set in .env or the parent process.
# GITHUB_TOKEN must have read:packages; do not commit credentials.

# For sdk-build.yml, Windows target/host triplets must match the installed MSVC.
QIGAO_VCPKG_WINDOWS_TRIPLET=x64-windows
QIGAO_VCPKG_WINDOWS_HOST_TRIPLET=x64-windows

# Exact published SDK Release Tags for sdk-build.yml (CI selection on 2026-10-16).
SALTS_RELEASE_TAG=v2.3.0-rc.17
SALTS_UTILS_RELEASE_TAG=v4.3.0-rc.11
CHTTP_RELEASE_TAG=v2.1.0-rc.6
TURBOWASM_RELEASE_TAG=v0.2.1
# Required only for Unix SDK builds with PraktorTools.
TURBOSCRIPT_RELEASE_TAG=v3.0.10
PRAKTOR_RELEASE_TAG=v0.4.8
