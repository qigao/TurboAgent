{
    "version": 6,
    "include": [
        "presets/BuildPresets.json",
        "presets/TestPresets.json",
        "presets/AndroidPresets.json"
    ],
    "configurePresets": [
        {
            "name": "base-win-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Windows, Base)",
            "inherits": [
                "dev-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-release-user",
            "hidden": true,
            "displayName": "Release Build (Windows, Base)",
            "inherits": [
                "release-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-linux-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Linux, Base)",
            "inherits": [
                "dev-linux-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-ci-release",
            "hidden": true,
            "inherits": [
                "release-mode",
                "pkg-vcpkg"
            ],
            "generator": "Ninja",
            "cacheVariables": {
                "ENABLE_TESTS": true,
                "BUILD_TESTS": true,
                "BUILD_TESTING": true,
                "BUILD_EXAMPLES": false,
                "BUILD_BENCHMARKS": false,
                "ENABLE_SANITIZER_ADDRESS": false,
                "ENABLE_ASAN": false,
                "ENABLE_WASM_TOOLS": true,
                "ENABLE_CODING_TOOLS": true,
                "ENABLE_MCP_TOOLS": true,
                "ENABLE_CODEX_BRIDGE": true
            }
        }
    ]
}
