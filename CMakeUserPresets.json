{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "C:/projects/cpp",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_ROOT": "C:/tools/vcpkg",
                "USER_ROOT": "C:/Users/lockg",
                "PROGRAM_FILES_X86_ROOT": "C:/Program Files (x86)",
                "WINDOWS_ROOT": "C:/Windows",
                "SCOOP_SHIMS_ROOT": "$env{USER_ROOT}/scoop/shims",
                "VS_ROOT": "$env{PROGRAM_FILES_X86_ROOT}/Microsoft Visual Studio/2022/BuildTools",
                "MSVC_VERSION": "14.44.35207",
                "MSVC_ROOT": "$env{VS_ROOT}/VC/Tools/MSVC/$env{MSVC_VERSION}",
                "MSVC_AUXILIARY_ROOT": "$env{VS_ROOT}/VC/Auxiliary/VS",
                "WINDOWS_SDK_ROOT": "$env{PROGRAM_FILES_X86_ROOT}/Windows Kits/10",
                "WINDOWS_SDK_VERSION": "10.0.26100.0",
                "INCLUDE": "$env{MSVC_ROOT}/include;$env{MSVC_AUXILIARY_ROOT}/include;$env{WINDOWS_SDK_ROOT}/Include/$env{WINDOWS_SDK_VERSION}/ucrt;$env{WINDOWS_SDK_ROOT}/Include/$env{WINDOWS_SDK_VERSION}/um;$env{WINDOWS_SDK_ROOT}/Include/$env{WINDOWS_SDK_VERSION}/shared;$env{WINDOWS_SDK_ROOT}/Include/$env{WINDOWS_SDK_VERSION}/winrt;$env{WINDOWS_SDK_ROOT}/Include/$env{WINDOWS_SDK_VERSION}/cppwinrt",
                "LIB": "$env{MSVC_ROOT}/lib/x64;$env{WINDOWS_SDK_ROOT}/Lib/$env{WINDOWS_SDK_VERSION}/ucrt/x64;$env{WINDOWS_SDK_ROOT}/Lib/$env{WINDOWS_SDK_VERSION}/um/x64",
                "LIBPATH": "$env{MSVC_ROOT}/lib/x64;$env{MSVC_ROOT}/lib/x86/store/references;$env{WINDOWS_SDK_ROOT}/UnionMetadata/$env{WINDOWS_SDK_VERSION};$env{WINDOWS_SDK_ROOT}/References/$env{WINDOWS_SDK_VERSION};$env{WINDOWS_ROOT}/Microsoft.NET/Framework64/v4.0.30319"
            },
            "cacheVariables": {}
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm",
                "FSM_ROOT": "$env{PKG_ROOT}/libfsm",
                "CMAKE_MAKE_PROGRAM": "$env{SCOOP_SHIMS_ROOT}/ninja.exe",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/windows",
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/windows/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm",
                "FSM_ROOT": "$env{PKG_ROOT}/libfsm",
                "CMAKE_MAKE_PROGRAM": "/usr/bin/ninja",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/linux",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "PKG_ROOT": "/opt",
                "VCPKG_ROOT": "/opt/vcpkg"
            }
        },
        {
            "name": "android-win-environment",
            "hidden": true,
            "inherits": "win-toolchain",
            "environment": {
                "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
                "ANDROID_NDK_VERSION": "28.2.13676358",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
            },
            "cacheVariables": {}
        },
        {
            "name": "android-win-paths",
            "hidden": true,
            "inherits": "ISWindows",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "$env{SCOOP_SHIMS_ROOT}/ninja.exe",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent-android/$env{ANDROID_BUILD_VARIANT}",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm-android",
                "FSM_ROOT": "$env{PKG_ROOT}/libfsm-android",
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/$env{ANDROID_BUILD_VARIANT}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/$env{ANDROID_BUILD_VARIANT}"
            }
        },
        {
            "name": "win-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{PKG_ROOT}/chttp/debug;$env{PKG_ROOT}/salts-utils/debug;$env{PKG_ROOT}/salts/debug;${sourceDir}/vcpkg_installed/windows/x64-windows/debug",
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/debug"
            },
            "environment": {
                "PATH": "${sourceDir}/vcpkg_installed/windows/x64-windows/debug/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{PKG_ROOT}/chttp/release;$env{PKG_ROOT}/salts-utils/release;$env{PKG_ROOT}/salts/release;${sourceDir}/vcpkg_installed/windows/x64-windows",
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/release"
            },
            "environment": {
                "PATH": "${sourceDir}/vcpkg_installed/windows/x64-windows/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ]
        },
        {
            "name": "linux-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{PKG_ROOT}/chttp/debug;$env{PKG_ROOT}/salts-utils/debug;$env{PKG_ROOT}/salts/debug;${sourceDir}/vcpkg_installed/linux/x64-linux/debug",
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/debug"
            },
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ]
        },
        {
            "name": "linux-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{PKG_ROOT}/chttp/release;$env{PKG_ROOT}/salts-utils/release;$env{PKG_ROOT}/salts/release;${sourceDir}/vcpkg_installed/linux/x64-linux",
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/release"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ]
        },
        {
            "name": "linux-sdk-package",
            "binaryDir": "${sourceDir}/build/linux-gcc-sdk-package",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{PKG_ROOT}/chttp/release;$env{PKG_ROOT}/salts-utils/release;$env{PKG_ROOT}/salts/release;${sourceDir}/vcpkg_installed/linux/x64-linux",
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "ENABLE_TESTS": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_EXAMPLES": "OFF",
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/release"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ]
        },
        {
            "name": "android-dependencies-debug",
            "hidden": true,
            "cacheVariables": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/debug",
                "CMAKE_PREFIX_PATH": "$env{PKG_ROOT}/chttp-android/debug;$env{PKG_ROOT}/salts-utils-android/debug;$env{PKG_ROOT}/salts-android/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp-android/debug"
            }
        },
        {
            "name": "android-dependencies-release",
            "hidden": true,
            "cacheVariables": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/release",
                "CMAKE_PREFIX_PATH": "$env{PKG_ROOT}/chttp-android/release;$env{PKG_ROOT}/salts-utils-android/release;$env{PKG_ROOT}/salts-android/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp-android/release"
            }
        },
        {
            "name": "android-arm64-v8a-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-arm64-v8a-debug"
            },
            "inherits": [
                "android-arm64-v8a-debug",
                "android-dependencies-debug",
                "android-win-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-arm64-v8a-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-arm64-v8a-release"
            },
            "inherits": [
                "android-arm64-v8a-release",
                "android-dependencies-release",
                "android-win-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-x86_64-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86_64-debug"
            },
            "inherits": [
                "android-x86_64-debug",
                "android-dependencies-debug",
                "android-win-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-x86_64-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86_64-release"
            },
            "inherits": [
                "android-x86_64-release",
                "android-dependencies-release",
                "android-win-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-x86-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86-debug"
            },
            "inherits": [
                "android-x86-debug",
                "android-dependencies-debug",
                "android-win-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-x86-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86-release"
            },
            "inherits": [
                "android-x86-release",
                "android-dependencies-release",
                "android-win-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        }
    ],
    "buildPresets": [
        {
            "name": "win-dev-user",
            "configurePreset": "win-dev-user"
        },
        {
            "name": "win-release-user",
            "configurePreset": "win-release-user"
        },
        {
            "name": "linux-dev-user",
            "configurePreset": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "configurePreset": "linux-release-user"
        },
        {
            "name": "linux-sdk-package",
            "configurePreset": "linux-sdk-package"
        },
        {
            "name": "android-arm64-v8a-debug-win",
            "configurePreset": "android-arm64-v8a-debug-win"
        },
        {
            "name": "android-arm64-v8a-release-win",
            "configurePreset": "android-arm64-v8a-release-win"
        },
        {
            "name": "android-x86_64-debug-win",
            "configurePreset": "android-x86_64-debug-win"
        },
        {
            "name": "android-x86_64-release-win",
            "configurePreset": "android-x86_64-release-win"
        },
        {
            "name": "android-x86-debug-win",
            "configurePreset": "android-x86-debug-win"
        },
        {
            "name": "android-x86-release-win",
            "configurePreset": "android-x86-release-win"
        },
        {
            "name": "install-android-arm64-v8a-debug-win",
            "configurePreset": "android-arm64-v8a-debug-win",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-android-arm64-v8a-release-win",
            "configurePreset": "android-arm64-v8a-release-win",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-android-x86_64-debug-win",
            "configurePreset": "android-x86_64-debug-win",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-android-x86_64-release-win",
            "configurePreset": "android-x86_64-release-win",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-android-x86-debug-win",
            "configurePreset": "android-x86-debug-win",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-android-x86-release-win",
            "configurePreset": "android-x86-release-win",
            "targets": [
                "install"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "win-dev-user",
            "inherits": "base-test",
            "configurePreset": "win-dev-user",
            "environment": {
                "PATH": "${sourceDir}/build/Msvc/bin;C:/projects/cpp/external/pkgs/salts-utils/debug/bin;C:/projects/cpp/external/pkgs/chttp/debug/bin;C:/projects/cpp/external/pkgs/salts/debug/bin;C:/projects/cpp/external/pkgs/turbowasm/bin;${sourceDir}/vcpkg_installed/windows/x64-windows/debug/bin;${sourceDir}/vcpkg_installed/windows/x64-windows/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "win-release-user",
            "inherits": "base-test",
            "configurePreset": "win-release-user",
            "environment": {
                "PATH": "${sourceDir}/build/Msvc-Release/bin;C:/projects/cpp/external/pkgs/salts-utils/release/bin;C:/projects/cpp/external/pkgs/chttp/release/bin;C:/projects/cpp/external/pkgs/salts/release/bin;C:/projects/cpp/external/pkgs/turbowasm/bin;${sourceDir}/vcpkg_installed/windows/x64-windows/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "linux-dev-user",
            "inherits": "base-test",
            "configurePreset": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "inherits": "base-test",
            "configurePreset": "linux-release-user"
        }
    ]
}
