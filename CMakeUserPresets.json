{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "vcpkg-cache-ci",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
                "VCPKG_BINARY_SOURCES": "$penv{VCPKG_BINARY_SOURCES}"
            }
        },
        {
            "name": "vcpkg-cache-linux",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "VCPKG_HOST_TRIPLET": "x64-linux"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{HOME}/.cache/qigao/vcpkg-cache"
            }
        },
        {
            "name": "vcpkg-cache-windows",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "VCPKG_HOST_TRIPLET": "x64-windows"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
                "RE2C_ROOT": "$env{PROJECT_ROOT}/external/pkgs/re2c/windows-x64"
            }
        },
        {
            "name": "vcpkg-cache",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
            "environment": {
                "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,${sourceDir}/cmake/vcpkg-cache.nuget.config,read",
                "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
                "RE2C_ROOT": "$penv{RE2C_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "C:/projects/cpp",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs/turboagent-sdk-20261010",
                "VCPKG_ROOT": "C:/tools/vcpkg"
            },
            "cacheVariables": {},
            "inherits": [
                "vcpkg-cache-windows"
            ]
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "cacheVariables": {
                "FSM_ROOT": "$env{PKG_ROOT}/libfsm",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/windows",
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/windows/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "cacheVariables": {
                "FSM_ROOT": "$env{PKG_ROOT}/libfsm",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/linux",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "PKG_ROOT": "/opt",
                "VCPKG_ROOT": "/opt/vcpkg"
            },
            "inherits": [
                "vcpkg-cache-linux"
            ]
        },
        {
            "name": "android-win-environment",
            "hidden": true,
            "inherits": "win-toolchain",
            "environment": {
                "ANDROID_SDK_ROOT": "$penv{LOCALAPPDATA}/Android/Sdk",
                "ANDROID_NDK_VERSION": "28.2.13676358",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
            },
            "cacheVariables": {}
        },
        {
            "name": "android-win-user-paths",
            "hidden": true,
            "inherits": [
                "vcpkg-cache-windows",
                "android-win-paths",
                "ISWindows"
            ],
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent-android/$env{ANDROID_BUILD_VARIANT}",
                "FSM_ROOT": "$env{PKG_ROOT}/libfsm-android",
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/$env{ANDROID_BUILD_VARIANT}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/$env{ANDROID_BUILD_VARIANT}"
            }
        },
        {
            "name": "win-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/windows/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent/debug"
            },
            "environment": {
                "PATH": "${sourceDir}/build/Msvc/bin${pathListSep}${sourceDir}/vcpkg_installed/windows/x64-windows/debug/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$env{TURBOWASM_ROOT}/bin${pathListSep}$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}",
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/debug",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm/debug"
            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/windows/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent/release",
                "ENABLE_TESTS": true,
                "BUILD_TESTS": true,
                "BUILD_BENCHMARKS": false
            },
            "environment": {
                "PATH": "${sourceDir}/build/Msvc-Release/bin${pathListSep}${sourceDir}/vcpkg_installed/windows/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$env{TURBOWASM_ROOT}/bin${pathListSep}$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}",
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/release",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm/release"
            },
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ]
        },
        {
            "name": "linux-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/linux/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent/debug"
            },
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ],
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/debug",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm/debug"
            }
        },
        {
            "name": "linux-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/linux/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent/release"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ],
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/release",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm/release"
            }
        },
        {
            "name": "linux-sdk-package",
            "binaryDir": "${sourceDir}/build/linux-gcc-sdk-package",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/linux/x64-linux",
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "ENABLE_TESTS": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_EXAMPLES": "OFF",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent/release"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ],
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp/release",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm/release"
            }
        },
        {
            "name": "android-dependencies-debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent-android/debug"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp-android/debug",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm-android/debug"
            }
        },
        {
            "name": "android-dependencies-release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turboagent-android/release"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/chttp-android/release",
                "TURBOWASM_ROOT": "$env{PKG_ROOT}/turbowasm-android/release"
            }
        },
        {
            "name": "android-arm64-v8a-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-arm64-v8a-debug"
            },
            "inherits": [
                "android-arm64-v8a-debug",
                "android-dependencies-debug",
                "android-win-user-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-arm64-v8a-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-arm64-v8a-release"
            },
            "inherits": [
                "android-arm64-v8a-release",
                "android-dependencies-release",
                "android-win-user-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-x86_64-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86_64-debug"
            },
            "inherits": [
                "android-x86_64-debug",
                "android-dependencies-debug",
                "android-win-user-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-x86_64-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86_64-release"
            },
            "inherits": [
                "android-x86_64-release",
                "android-dependencies-release",
                "android-win-user-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-x86-debug-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86-debug"
            },
            "inherits": [
                "android-x86-debug",
                "android-dependencies-debug",
                "android-win-user-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        },
        {
            "name": "android-x86-release-win",
            "environment": {
                "ANDROID_BUILD_VARIANT": "android-x86-release"
            },
            "inherits": [
                "android-x86-release",
                "android-dependencies-release",
                "android-win-user-paths",
                "android-win-environment"
            ],
            "cacheVariables": {}
        }
    ],
