if(NOT DEFINED WORKER OR NOT EXISTS "${WORKER}" OR
   NOT DEFINED ROOT OR NOT IS_ABSOLUTE "${ROOT}" OR
   NOT CUT MATCHES "^(after_claim|in_model|before_applied|after_applied|before_delivery|after_following_run)$")
  message(FATAL_ERROR "Invalid Inbox process test configuration")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${ROOT}/${CUT}-${nonce} with spaces")
if(EXISTS "${work}")
  message(FATAL_ERROR "Inbox process directory already exists: ${work}")
endif()
file(MAKE_DIRECTORY "${work}")
function(run_stage stage expected)
  execute_process(COMMAND "${WORKER}" "${stage}" "${CUT}" "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR
      "${CUT}/${stage}: expected exit ${expected}, got ${result}\n${output}${error}\nEvidence retained at ${work}")
  endif()
endfunction()
run_stage(init 0)
run_stage(crash 86)
run_stage(inspect 0)
run_stage(recover 0)
run_stage(sticky 0)
file(REMOVE_RECURSE "${work}")
