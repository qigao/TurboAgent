if(NOT DEFINED WORKER OR NOT EXISTS "${WORKER}" OR
   NOT DEFINED ROOT OR NOT IS_ABSOLUTE "${ROOT}" OR
   NOT CUT MATCHES "^(before_write|after_write|lost_ack|queue_rejected|in_model|before_delivery|after_observation)$")
  message(FATAL_ERROR "Invalid admission process configuration")
endif()
set(before_write_marker "before_atomic_create")
set(after_write_marker "after_atomic_create_before_enqueue")
set(lost_ack_marker "after_lost_ack_return")
set(queue_rejected_marker "after_queue_rejection")
set(in_model_marker "model_entry_after_counter_commit")
set(before_delivery_marker "terminal_before_delivery")
set(after_observation_marker "terminal_observation_before_delivery")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${ROOT}/${CUT}-${nonce} with spaces")
if(EXISTS "${work}")
  message(FATAL_ERROR "Admission case already exists: ${work}")
endif()
file(MAKE_DIRECTORY "${work}")

function(run_stage stage expected)
  execute_process(COMMAND "${WORKER}" "${stage}" "${CUT}" "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${CUT}/${stage}: expected ${expected}, got ${result}\n${output}${error}\nEvidence: ${work}")
  endif()
  if(stage STREQUAL "crash" AND NOT "${output}${error}" MATCHES
      "ADMISSION_CRASH cut=${CUT} boundary=${${CUT}_marker}")
    message(FATAL_ERROR "Missing exact admission crash marker: ${CUT}\n${output}${error}\nEvidence: ${work}")
  endif()
  if(stage STREQUAL "crash")
    if(CUT STREQUAL "queue_rejected")
      set(expected_submitted 2)
    else()
      set(expected_submitted 0)
    endif()
    if(NOT "${output}${error}" MATCHES "ADMISSION_PREQUEUE expected=${expected_submitted} submitted=${expected_submitted}")
      message(FATAL_ERROR "Missing pre-enqueue pool evidence: ${CUT}\n${output}${error}\nEvidence: ${work}")
    endif()
  endif()
  if(stage STREQUAL "reject" AND NOT "${output}${error}" MATCHES
      "ADMISSION_REJECT cut=${CUT} duplicate=EALREADY unchanged=1")
    message(FATAL_ERROR "Missing duplicate rejection evidence: ${CUT}\n${output}${error}\nEvidence: ${work}")
  endif()
  message(STATUS "${stage}: ${output}${error}")
endfunction()

run_stage(init 0)
run_stage(crash 86)
run_stage(inspect 0)
if(NOT CUT STREQUAL "before_write")
  run_stage(reject 0)
endif()
run_stage(healthy 0)
run_stage(verify 0)
file(REMOVE_RECURSE "${work}")
