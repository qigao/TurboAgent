if(NOT DEFINED WORKER OR NOT EXISTS "${WORKER}" OR NOT DEFINED ROOT OR NOT IS_ABSOLUTE "${ROOT}" OR
   NOT CUT MATCHES "^(before_write|after_write|lost_ack|after_handoff|after_delivery)$" OR
   NOT KIND MATCHES "^(input|collect)$")
  message(FATAL_ERROR "Invalid group handoff process configuration")
endif()
set(before_write_marker "before_atomic_create")
set(after_write_marker "after_atomic_create_before_handoff")
set(lost_ack_marker "after_lost_ack_return")
set(after_handoff_marker "after_handoff_before_delivery")
set(after_delivery_marker "after_application_delivery")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${ROOT}/${KIND}-${CUT}-${nonce} with spaces")
if(EXISTS "${work}")
  message(FATAL_ERROR "Group case exists: ${work}")
endif()
file(MAKE_DIRECTORY "${work}")
function(run_stage stage expected)
  execute_process(COMMAND "${WORKER}" "${stage}" "${CUT}" "${KIND}" "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${KIND}/${CUT}/${stage}: expected ${expected}, got ${result}\n${output}${error}\nEvidence: ${work}")
  endif()
  if(stage STREQUAL "crash" AND
      (NOT "${output}${error}" MATCHES "GROUP_CRASH kind=${KIND} cut=${CUT} boundary=${${CUT}_marker}" OR
       NOT "${output}${error}" MATCHES "GROUP_PRE_HANDOFF members=2 outputs_empty=1"))
    message(FATAL_ERROR "Missing exact group crash/empty-handoff evidence\n${output}${error}\nEvidence: ${work}")
  endif()
  if(stage STREQUAL "recover" AND NOT "${output}${error}" MATCHES "GROUP_RECOVER old_handoff_retried=0 healthy_delivery=1")
    message(FATAL_ERROR "Missing group reconciliation evidence\n${output}${error}\nEvidence: ${work}")
  endif()
  message(STATUS "${stage}: ${output}${error}")
endfunction()
run_stage(init 0)
run_stage(crash 86)
run_stage(inspect 0)
run_stage(recover 0)
run_stage(verify 0)
file(REMOVE_RECURSE "${work}")
