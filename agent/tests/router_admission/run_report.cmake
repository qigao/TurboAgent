if(NOT DEFINED WORKER OR NOT EXISTS "${WORKER}" OR NOT DEFINED CLI OR NOT EXISTS "${CLI}" OR
   NOT DEFINED ROOT OR NOT IS_ABSOLUTE "${ROOT}" OR
   NOT CUT MATCHES "^(before_manifest|after_manifest|after_fan_in|after_review|before_ready|after_ready|after_return|after_delivery|stop_before_observation|stop_after_observation|stop_before_record|stop_after_record|stop_after_return|stop_lost_ack)$")
  message(FATAL_ERROR "Invalid audited report process configuration")
endif()
set(before_manifest_marker "before_manifest_create")
set(after_manifest_marker "after_manifest_before_admission")
set(after_fan_in_marker "after_cohort_before_aggregation")
set(after_review_marker "after_review_intent_before_enqueue")
set(before_ready_marker "before_ready_create")
set(after_ready_marker "after_ready_before_publication")
set(after_return_marker "after_return_before_delivery")
set(after_delivery_marker "after_application_delivery")
set(stop_before_observation_marker "after_drain_before_terminal_observation")
set(stop_after_observation_marker "after_terminal_observation_before_stop_record")
set(stop_before_record_marker "after_terminal_observation_before_stop_record")
set(stop_after_record_marker "after_stop_record_before_error_return")
set(stop_after_return_marker "after_stop_error_return")
set(stop_lost_ack_marker "after_stop_lost_ack_return")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${ROOT}/${CUT}-${nonce} with spaces")
if(EXISTS "${work}")
  message(FATAL_ERROR "Report process case exists: ${work}")
endif()
file(MAKE_DIRECTORY "${work}")
function(run_stage stage expected)
  execute_process(COMMAND "${WORKER}" "${stage}" "${CUT}" "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${CUT}/${stage}: expected ${expected}, got ${result}\n${output}${error}\nEvidence: ${work}")
  endif()
  if(stage STREQUAL "crash" AND
      (NOT "${output}${error}" MATCHES "REPORT_CRASH cut=${CUT} boundary=${${CUT}_marker}" OR
       NOT "${output}${error}" MATCHES "REPORT_PREPUBLISH delivery_null=1"))
    message(FATAL_ERROR "Missing report crash/pre-publication evidence\n${output}${error}\nEvidence: ${work}")
  endif()
  if(stage STREQUAL "recover" AND NOT "${output}${error}" MATCHES "REPORT_RECOVER old_report_retried=0 healthy_delivery=1")
    message(FATAL_ERROR "Missing report reconciliation evidence\n${output}${error}\nEvidence: ${work}")
  endif()
  message(STATUS "${stage}: ${output}${error}")
endfunction()
function(inspect_cli)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env
      --unset=REPORT_A_MODEL --unset=REPORT_B_MODEL --unset=REPORT_PLAN_MODEL --unset=REPORT_EXEC_MODEL
      "${CLI}" --inspect "${work}" subject report-host
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  if(CUT STREQUAL "before_manifest")
    if(NOT "${result}" STREQUAL "1" OR NOT "${output}" STREQUAL "" OR NOT "${error}" MATCHES "inspection failed")
      message(FATAL_ERROR "Expected missing manifest inspection failure: ${result}\n${output}${error}\nEvidence: ${work}")
    endif()
  else()
    if(NOT "${result}" STREQUAL "0" OR NOT "${error}" STREQUAL "")
      message(FATAL_ERROR "CLI inspection failed: ${result}\n${output}${error}\nEvidence: ${work}")
    endif()
    string(JSON semantics GET "${output}" semantics)
    string(JSON recovery GET "${output}" recovery_authorized)
    string(JSON delivered GET "${output}" delivery_proven)
    if(NOT semantics STREQUAL "historical_report_trace_inspection" OR recovery OR delivered)
      message(FATAL_ERROR "Invalid inspection semantics\n${output}\nEvidence: ${work}")
    endif()
  endif()
endfunction()
run_stage(init 0)
run_stage(crash 86)
run_stage(inspect 0)
inspect_cli()
run_stage(recover 0)
run_stage(verify 0)
inspect_cli()
file(REMOVE_RECURSE "${work}")
