if(NOT DEFINED WORKER OR NOT EXISTS "${WORKER}" OR NOT DEFINED ROOT OR NOT IS_ABSOLUTE "${ROOT}" OR
   NOT CUT MATCHES "^(before_write|after_write|lost_ack|queue_rejected|in_tool|before_delivery|after_observation)$" OR
   NOT DECISION MATCHES "^(approve|reject)$" OR (CUT STREQUAL "in_tool" AND DECISION STREQUAL "reject"))
  message(FATAL_ERROR "Invalid review process configuration")
endif()
set(before_write_marker "before_atomic_create")
set(after_write_marker "after_atomic_create_before_enqueue")
set(lost_ack_marker "after_lost_ack_return")
set(queue_rejected_marker "after_queue_rejection")
set(in_tool_marker "tool_effect_committed_before_return")
set(before_delivery_marker "terminal_before_delivery")
set(after_observation_marker "terminal_observation_before_delivery")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${ROOT}/${CUT}-${DECISION}-${nonce} with spaces")
if(EXISTS "${work}")
  message(FATAL_ERROR "Review case exists: ${work}")
endif()
file(MAKE_DIRECTORY "${work}")
function(run_stage stage expected)
  execute_process(COMMAND "${WORKER}" "${stage}" "${CUT}" "${DECISION}" "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 12)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${CUT}/${DECISION}/${stage}: expected ${expected}, got ${result}\n${output}${error}\nEvidence: ${work}")
  endif()
  if(stage STREQUAL "crash")
    if(CUT STREQUAL "queue_rejected")
      set(submitted 3)
    else()
      set(submitted 1)
    endif()
    if(NOT "${output}${error}" MATCHES "REVIEW_CRASH cut=${CUT} decision=${DECISION} boundary=${${CUT}_marker}" OR
       NOT "${output}${error}" MATCHES "REVIEW_PREQUEUE expected=${submitted} submitted=${submitted}")
      message(FATAL_ERROR "Missing exact review crash/pre-enqueue evidence\n${output}${error}\nEvidence: ${work}")
    endif()
  endif()
  if(stage STREQUAL "recover" AND NOT "${output}${error}" MATCHES
      "REVIEW_RECOVER cut=${CUT} decision=${DECISION} old_effect_retried=0 healthy_effect=1 healthy_delivery=1")
    message(FATAL_ERROR "Missing review reconciliation evidence\n${output}${error}\nEvidence: ${work}")
  endif()
  message(STATUS "${stage}: ${output}${error}")
endfunction()
run_stage(init 0)
run_stage(crash 86)
run_stage(inspect 0)
run_stage(recover 0)
run_stage(verify 0)
file(REMOVE_RECURSE "${work}")
