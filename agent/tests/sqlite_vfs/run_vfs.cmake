if(NOT DEFINED WORKER OR NOT EXISTS "${WORKER}" OR
   NOT DEFINED ROOT OR NOT IS_ABSOLUTE "${ROOT}" OR
   NOT PHASE MATCHES "^(started|committed)$" OR
   NOT FAULT MATCHES "^(none|journal_full|journal_write|journal_sync|database_write|database_sync|journal_partial|database_partial|journal_write_after|database_write_after|journal_sync_after|database_sync_after|crash_journal_sync_before|crash_journal_sync_after|crash_database_sync_before|crash_database_sync_after|crash_journal_partial|crash_database_partial)$")
  message(FATAL_ERROR "Invalid SQLite VFS test configuration")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${ROOT}/${PHASE}-${FAULT}-${nonce} with spaces")
if(EXISTS "${work}")
  message(FATAL_ERROR "SQLite VFS case directory already exists: ${work}")
endif()
file(MAKE_DIRECTORY "${work}")

function(run_stage stage expected)
  execute_process(COMMAND "${WORKER}" "${stage}" "${PHASE}" "${FAULT}" "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${PHASE}/${FAULT}/${stage}: exit ${result}\n${output}${error}\nEvidence retained at ${work}")
  endif()
  if(expected EQUAL 86 AND (NOT output MATCHES "VFS_CRASH hit=1" OR
      NOT output MATCHES "ARM phase=${PHASE} fault=${FAULT}"))
    message(FATAL_ERROR "Expected VFS cut was not observed: ${output}${error}")
  endif()
  message(STATUS "${output}")
endfunction()

run_stage(init 0)
if(FAULT MATCHES "^crash_")
  run_stage(inject 86)
  # Raw byte snapshots do not open SQLite or repair the hot journal. The first
  # database opener after the crash must be the actual production Store below.
  if(NOT EXISTS "${work}/journal.db-journal")
    message(FATAL_ERROR "No rollback journal at the chosen VFS crash cut")
  endif()
  file(SIZE "${work}/journal.db-journal" journal_bytes)
  if(journal_bytes EQUAL 0)
    message(FATAL_ERROR "Empty rollback journal at the chosen VFS crash cut")
  endif()
  file(SHA256 "${work}/journal.db" database_sha256)
  file(SHA256 "${work}/journal.db-journal" journal_sha256)
  file(MAKE_DIRECTORY "${work}/pre-recovery")
  file(COPY "${work}/journal.db" "${work}/journal.db-journal" DESTINATION "${work}/pre-recovery")
  message(STATUS "PRE_RECOVERY journal_bytes=${journal_bytes} database_sha256=${database_sha256} journal_sha256=${journal_sha256}")
else()
  run_stage(inject 0)
  run_stage(inspect 0)
endif()
run_stage(recover 0)
run_stage(inspect 0)
run_stage(replay 0)
run_stage(inspect 0)
file(REMOVE_RECURSE "${work}")
