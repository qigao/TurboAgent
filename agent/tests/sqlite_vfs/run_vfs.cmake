if(NOT DEFINED WORKER OR NOT EXISTS "${WORKER}" OR
   NOT DEFINED ROOT OR NOT IS_ABSOLUTE "${ROOT}" OR
   NOT PHASE MATCHES "^(started|committed)$" OR
   NOT FAULT MATCHES "^(none|journal_full|journal_write|journal_sync|database_write|database_sync|journal_partial|database_partial|journal_write_after|database_write_after|journal_sync_after|database_sync_after|crash_journal_sync_before|crash_journal_sync_after|crash_database_sync_before|crash_database_sync_after|crash_journal_partial|crash_database_partial|journal_invalidate_before|journal_invalidate_after|crash_journal_invalidate_before|crash_journal_invalidate_after)$")
  message(FATAL_ERROR "Invalid SQLite VFS test configuration")
endif()
if(DEFINED RECOVERY_FAULT AND (NOT FAULT STREQUAL "crash_database_sync_after" OR
    NOT RECOVERY_FAULT MATCHES "^(write_before|write_after|sync_before|sync_after|partial_then_sync|write_error|sync_error)$"))
  message(FATAL_ERROR "Invalid recovery-restart configuration")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${ROOT}/${PHASE}-${FAULT}-${RECOVERY_FAULT}-${nonce} with spaces")
if(EXISTS "${work}")
  message(FATAL_ERROR "SQLite VFS case directory already exists: ${work}")
endif()
file(MAKE_DIRECTORY "${work}")

function(run_stage stage expected)
  execute_process(COMMAND "${WORKER}" "${stage}" "${PHASE}" "${FAULT}" "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${PHASE}/${FAULT}/${stage}: exit ${result}\n${output}${error}\nEvidence retained at ${work}")
  endif()
  if(expected EQUAL 86)
    if(NOT output MATCHES "VFS_CRASH hit=1" OR NOT output MATCHES "ARM phase=${PHASE} fault=${FAULT}")
      message(FATAL_ERROR "Expected VFS cut was not observed: ${output}${error}")
    endif()
    if(stage MATCHES "^recover_fail_")
      string(REGEX REPLACE "^recover_fail_" "" profile "${stage}")
      if(NOT output MATCHES "RECOVERY_ARM phase=${PHASE} fault=${FAULT} recovery=${profile}")
        message(FATAL_ERROR "Expected recovery-open cut was not observed: ${output}${error}")
      endif()
      if(profile MATCHES "^sync_")
        set(operation 1)
      else()
        set(operation 0)
      endif()
      if(profile MATCHES "_before$")
        set(mode 3)
      elseif(profile STREQUAL "partial_then_sync")
        set(mode 5)
      else()
        set(mode 4)
      endif()
      if(NOT output MATCHES "VFS_CRASH hit=1 mode=${mode} kind=0 operation=${operation}")
        message(FATAL_ERROR "Recovery crashed at the wrong native operation: ${output}${error}")
      endif()
    endif()
  endif()
  if(stage MATCHES "^recover_fail_.*_error$" AND NOT output MATCHES "RECOVERY_ERROR.*out_store_clear=1 live_files=0")
    message(FATAL_ERROR "Recovery-open error cleanup was not observed: ${output}${error}")
  endif()
  message(STATUS "${output}")
endfunction()

run_stage(init 0)
if(FAULT MATCHES "^crash_")
  run_stage(inject 86)
  # Raw byte snapshots do not open SQLite or repair the hot journal. The first
  # database opener after the crash must be the actual production Store below.
  if(NOT EXISTS "${work}/journal.db-journal")
    message(FATAL_ERROR "No rollback journal at the chosen VFS crash cut")
  endif()
  file(SIZE "${work}/journal.db-journal" journal_bytes)
  if(journal_bytes EQUAL 0)
    message(FATAL_ERROR "Empty rollback journal at the chosen VFS crash cut")
  endif()
  file(SHA256 "${work}/journal.db" database_sha256)
  file(SHA256 "${work}/journal.db-journal" journal_sha256)
  file(READ "${work}/journal.db-journal" journal_header OFFSET 0 LIMIT 8 HEX)
  if(FAULT STREQUAL "crash_journal_invalidate_before" AND NOT journal_header STREQUAL "d9d505f920a163d7")
    message(FATAL_ERROR "Pre-commit cut did not retain a valid journal header: ${journal_header}")
  endif()
  if(FAULT STREQUAL "crash_journal_invalidate_after" AND NOT journal_header STREQUAL "0000000000000000")
    message(FATAL_ERROR "Post-commit cut did not invalidate the native journal header: ${journal_header}")
  endif()
  file(MAKE_DIRECTORY "${work}/pre-recovery")
  file(COPY "${work}/journal.db" "${work}/journal.db-journal" DESTINATION "${work}/pre-recovery")
  message(STATUS "PRE_RECOVERY journal_bytes=${journal_bytes} header=${journal_header} database_sha256=${database_sha256} journal_sha256=${journal_sha256}")
else()
  run_stage(inject 0)
  run_stage(inspect 0)
endif()
if(DEFINED RECOVERY_FAULT)
  run_stage(recovery_effects 0)
  set(initial_journal_sha256 "${journal_sha256}")
  foreach(attempt RANGE 1 2)
    set(recovery "${RECOVERY_FAULT}")
    # A first partial recovery can restore all changed bytes even though only
    # half the requested page was written. Interrupt the next attempt at sync.
    if(RECOVERY_FAULT STREQUAL "partial_then_sync" AND attempt EQUAL 2)
      set(recovery sync_after)
    endif()
    if(recovery MATCHES "_error$")
      run_stage("recover_fail_${recovery}" 0)
    else()
      run_stage("recover_fail_${recovery}" 86)
    endif()
    if(NOT EXISTS "${work}/journal.db-journal")
      message(FATAL_ERROR "Recovery interruption lost the original rollback journal")
    endif()
    file(SHA256 "${work}/journal.db-journal" recovery_journal_sha256)
    file(READ "${work}/journal.db-journal" recovery_header OFFSET 0 LIMIT 8 HEX)
    if(NOT recovery_header STREQUAL "d9d505f920a163d7" OR
       NOT recovery_journal_sha256 STREQUAL initial_journal_sha256)
      message(FATAL_ERROR "Recovery interruption changed the hot-journal evidence")
    endif()
    file(MAKE_DIRECTORY "${work}/pre-recovery/attempt-${attempt}")
    file(COPY "${work}/journal.db" "${work}/journal.db-journal"
      DESTINATION "${work}/pre-recovery/attempt-${attempt}")
    message(STATUS "RECOVERY_RETAINED attempt=${attempt} recovery=${recovery} header=${recovery_header} journal_sha256=${recovery_journal_sha256}")
    run_stage(recovery_effects 0)
  endforeach()
endif()
run_stage(recover 0)
run_stage(inspect 0)
run_stage(replay 0)
run_stage(inspect 0)
file(REMOVE_RECURSE "${work}")
