cmake_minimum_required(VERSION 3.20)

# User values travel in the environment so Windows cmd.exe cannot interpret
# regex operators or program arguments before CMake passes them as argv.
set(_preset "$ENV{TURBOAGENT_LOCAL_PRESET}")
set(_target "$ENV{TURBOAGENT_LOCAL_TARGET}")
set(_test_regex "$ENV{TURBOAGENT_LOCAL_TEST_REGEX}")
get_filename_component(_source_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

if(LOCAL_ACTION STREQUAL "validate")
    set(_task "$ENV{TURBOAGENT_LOCAL_TASK}")
    set(_testing FALSE)
    if(_task STREQUAL "test" OR
       ((_task STREQUAL "all" OR _task STREQUAL "install") AND
        "$ENV{TURBOAGENT_LOCAL_TEST}" STREQUAL "1"))
        set(_testing TRUE)
    endif()
    if(NOT _target STREQUAL "")
        if(NOT _task MATCHES "^(all|build|test|run)$" OR
           "$ENV{TURBOAGENT_LOCAL_INSTALL}" STREQUAL "1")
            message(FATAL_ERROR "TARGET is only supported for local build/test/run; installation requires the complete graph")
        endif()
        if(_target MATCHES "^-")
            message(FATAL_ERROR "TARGET must be a CMake target name, not an option")
        endif()
        if(_testing AND _test_regex STREQUAL "")
            message(FATAL_ERROR "Set TEST_REGEX with TARGET when testing, or use TASK=build / TEST=0")
        endif()
    endif()
    if(NOT _test_regex STREQUAL "" AND NOT _testing)
        message(FATAL_ERROR "TEST_REGEX requires a test stage")
    endif()
    if(_task STREQUAL "run")
        if("$ENV{TURBOAGENT_RUN_PROGRAM}" STREQUAL "")
            message(FATAL_ERROR "TASK=run requires RUN_PROGRAM")
        endif()
        if("$ENV{TURBOAGENT_LOCAL_INSTALL}" STREQUAL "1")
            message(FATAL_ERROR "TASK=run does not install; use TASK=install separately")
        endif()
        # Check argument shape before configuring/building; the executable may
        # not exist until the selected target has been built.
        set(_check_run_args TRUE)
    elseif(NOT "$ENV{TURBOAGENT_RUN_PROGRAM}" STREQUAL "" OR
           NOT "$ENV{TURBOAGENT_RUN_ARGS}" STREQUAL "[]")
        message(FATAL_ERROR "RUN_PROGRAM and RUN_ARGS require TASK=run")
    endif()
elseif(LOCAL_ACTION STREQUAL "build")
    execute_process(COMMAND "${CMAKE_COMMAND}" --build --preset "${_preset}" --target "${_target}"
        WORKING_DIRECTORY "${_source_dir}" COMMAND_ERROR_IS_FATAL ANY)
elseif(LOCAL_ACTION STREQUAL "test")
    execute_process(COMMAND ctest --preset "${_preset}" --output-on-failure -R "${_test_regex}" --no-tests=error
        WORKING_DIRECTORY "${_source_dir}" COMMAND_ERROR_IS_FATAL ANY)
elseif(LOCAL_ACTION STREQUAL "run")
    if(TURBOAGENT_CROSSCOMPILING)
        message(FATAL_ERROR "TASK=run requires a native host profile; no cross-target runner is configured")
    endif()
    set(_check_run_args TRUE)
else()
    message(FATAL_ERROR "Unknown local build action: ${LOCAL_ACTION}")
endif()

if(_check_run_args)
    set(_args "$ENV{TURBOAGENT_RUN_ARGS}")
    string(JSON _args_type ERROR_VARIABLE _args_error TYPE "${_args}")
    if(_args_error OR NOT _args_type STREQUAL "ARRAY")
        message(FATAL_ERROR "RUN_ARGS must be a JSON array of strings")
    endif()
    string(JSON _args_count LENGTH "${_args}")
    set(_index 0)
    set(_command "execute_process(COMMAND \"\${_program}\"")
    while(_index LESS _args_count)
        string(JSON _arg_type TYPE "${_args}" ${_index})
        if(NOT _arg_type STREQUAL "STRING")
            message(FATAL_ERROR "RUN_ARGS[${_index}] must be a string")
        endif()
        string(JSON _arg_${_index} GET "${_args}" ${_index})
        # Only generated variable references enter code. Values stay quoted data,
        # preserving empty arguments, semicolons, quotes and shell metacharacters.
        string(APPEND _command " \"\${_arg_${_index}}\"")
        math(EXPR _index "${_index} + 1")
    endwhile()
    if(LOCAL_ACTION STREQUAL "run")
        if("$ENV{TURBOAGENT_RUN_PROGRAM}" STREQUAL "")
            message(FATAL_ERROR "RUN_PROGRAM is required")
        endif()
        get_filename_component(_program "$ENV{TURBOAGENT_RUN_PROGRAM}" ABSOLUTE BASE_DIR "${_source_dir}")
        if(NOT EXISTS "${_program}" OR IS_DIRECTORY "${_program}")
            message(FATAL_ERROR "RUN_PROGRAM does not name an executable file: ${_program}")
        endif()
        string(APPEND _command " WORKING_DIRECTORY \"\${_source_dir}\" COMMAND_ERROR_IS_FATAL ANY)")
        cmake_language(EVAL CODE "${_command}")
    endif()
endif()
