@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Salts 1.8.3 EXACT CONFIG)
find_dependency(SaltsUtils 4.1.3 EXACT CONFIG)

if("@ENABLE_MCP_TOOLS@" STREQUAL "ON" OR "@ENABLE_LANGCHAIN@" STREQUAL "ON")
  find_dependency(Chttp 1.1.4 EXACT CONFIG)
endif()
if("@ENABLE_LLM_SANDBOX@" STREQUAL "ON")
  find_dependency(TurboWasm CONFIG)
endif()
if("@ENABLE_LANGCHAIN@" STREQUAL "ON")
  find_dependency(OpenSSL)
  find_dependency(unofficial-sqlite3 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboAgentTargets.cmake")
check_required_components(TurboAgent)
