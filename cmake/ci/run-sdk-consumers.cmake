cmake_minimum_required(VERSION 3.25)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(rid "$ENV{SDK_RID}")
find_program(ctest NAMES ctest REQUIRED)
set(runtime_paths "$ENV{TURBOAGENT_CONSUMER_SDK_ROOT}/bin" "$ENV{TURBOAGENT_CONSUMER_SDK_ROOT}/lib"
  "$ENV{TURBOAGENT_CONSUMER_PORTS_ROOT}/bin" "$ENV{TURBOAGENT_CONSUMER_PORTS_ROOT}/lib")
foreach(root SALTS_ROOT SALTS_UTILS_ROOT CHTTP_ROOT TURBOWASM_ROOT
             TURBOSCRIPT_ROOT PRAKTOR_ROOT)
  if(NOT "$ENV{${root}}" STREQUAL "")
    list(APPEND runtime_paths "$ENV{${root}}/bin" "$ENV{${root}}/lib")
  endif()
endforeach()
if(WIN32)
  list(JOIN runtime_paths ";" runtime_path)
  set(ENV{PATH} "${runtime_path};$ENV{PATH}")
else()
  list(JOIN runtime_paths ":" runtime_path)
  set(ENV{LD_LIBRARY_PATH} "${runtime_path}:$ENV{LD_LIBRARY_PATH}")
endif()
foreach(stage configure build test)
  if(stage STREQUAL "configure")
    set(command "${CMAKE_COMMAND}" --fresh --preset native)
  elseif(stage STREQUAL "build")
    set(command "${CMAKE_COMMAND}" --build --preset native)
  else()
    set(command "${ctest}" --preset native)
  endif()
  message(STATUS "Installed ${rid} SDK consumer: ${stage}")
  execute_process(COMMAND ${command}
    WORKING_DIRECTORY "${source}/tests/installed_sdk"
    RESULT_VARIABLE status TIMEOUT 180)
  if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "Installed SDK ${stage} failed: ${status}")
  endif()
endforeach()
