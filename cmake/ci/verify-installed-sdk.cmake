cmake_minimum_required(VERSION 3.25)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(rid "$ENV{SDK_RID}")
if(rid STREQUAL "linux-x64")
  set(profile ci-linux-release)
elseif(rid STREQUAL "windows-x64")
  set(profile ci-windows-release)
else()
  message(FATAL_ERROR "Installed consumer verification requires a supported native RID")
endif()
set(producer_build "${source}/build/${profile}")
set(hidden_build "${source}/build/hidden-${profile}")
load_cache("${producer_build}" READ_WITH_PREFIX producer_
  VCPKG_INSTALLED_DIR VCPKG_TARGET_TRIPLET CMAKE_C_COMPILER CMAKE_CXX_COMPILER)
set(ports "${producer_VCPKG_INSTALLED_DIR}/${producer_VCPKG_TARGET_TRIPLET}")
set(original "${source}/build/sdk/${rid}")
set(relocated "${source}/build/relocated-sdk/${rid}")
cmake_path(IS_PREFIX producer_build "${ports}" NORMALIZE ports_in_build)
if(NOT IS_DIRECTORY "${ports}" OR NOT IS_DIRECTORY "${original}" OR
   EXISTS "${relocated}" OR EXISTS "${hidden_build}" OR ports_in_build)
  message(FATAL_ERROR "Require the producer's installed ports and SDK, and an unused relocation destination")
endif()
find_program(ctest NAMES ctest REQUIRED)
file(MAKE_DIRECTORY "${source}/build/relocated-sdk")
file(RENAME "${original}" "${relocated}")
file(RENAME "${producer_build}" "${hidden_build}" RESULT moved)
if(NOT "${moved}" STREQUAL "0")
  file(RENAME "${relocated}" "${original}")
  message(FATAL_ERROR "Cannot hide the producer build tree: ${moved}")
endif()
set(ENV{TURBOAGENT_CONSUMER_SDK_ROOT} "${relocated}")
set(ENV{TURBOAGENT_CONSUMER_PORTS_ROOT} "${ports}")
set(ENV{TURBOAGENT_CONSUMER_CC} "${producer_CMAKE_C_COMPILER}")
set(ENV{TURBOAGENT_CONSUMER_CXX} "${producer_CMAKE_CXX_COMPILER}")
set(runtime_paths "${relocated}/bin" "${relocated}/lib" "${ports}/bin" "${ports}/lib")
foreach(root SALTS_ROOT SALTS_UTILS_ROOT CHTTP_ROOT TURBOWASM_ROOT
             TURBOSCRIPT_ROOT PRAKTOR_ROOT)
  if(NOT "$ENV{${root}}" STREQUAL "")
    list(APPEND runtime_paths "$ENV{${root}}/bin" "$ENV{${root}}/lib")
  endif()
endforeach()
if(WIN32)
  list(JOIN runtime_paths ";" runtime_path)
  set(ENV{PATH} "${runtime_path};$ENV{PATH}")
else()
  list(JOIN runtime_paths ":" runtime_path)
  set(ENV{LD_LIBRARY_PATH} "${runtime_path}:$ENV{LD_LIBRARY_PATH}")
endif()
foreach(stage configure build test)
  if(stage STREQUAL "configure")
    set(command "${CMAKE_COMMAND}" --fresh --preset native)
  elseif(stage STREQUAL "build")
    set(command "${CMAKE_COMMAND}" --build --preset native)
  else()
    set(command "${ctest}" --preset native)
  endif()
  message(STATUS "Relocated ${rid} installed SDK: ${stage}; original prefix and producer build tree are absent")
  execute_process(COMMAND ${command}
    WORKING_DIRECTORY "${source}/tests/installed_sdk"
    RESULT_VARIABLE status TIMEOUT 180)
  if(NOT "${status}" STREQUAL "0")
    file(RENAME "${hidden_build}" "${producer_build}")
    file(RENAME "${relocated}" "${original}")
    message(FATAL_ERROR "Installed SDK ${stage} failed: ${status}")
  endif()
endforeach()
# Restore the qualified SDK for the unchanged artifact/packaging stages.
file(RENAME "${hidden_build}" "${producer_build}")
file(RENAME "${relocated}" "${original}")
