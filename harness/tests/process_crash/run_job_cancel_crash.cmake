if(NOT DEFINED WORKER OR NOT EXISTS "${WORKER}" OR
   NOT DEFINED ROOT OR NOT IS_ABSOLUTE "${ROOT}" OR
   NOT CUT MATCHES "^cancel_(pending|committed|sent)_(before|after|lost_ack|returned)$")
  message(FATAL_ERROR "Invalid Job cancellation crash case")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(work "${ROOT}/${CUT}-${nonce} with spaces")
if(EXISTS "${work}")
  message(FATAL_ERROR "Refusing to reuse cancellation case")
endif()
file(MAKE_DIRECTORY "${work}")
function(run_stage stage expected)
  execute_process(COMMAND "${WORKER}" "${stage}" "${CUT}" "${work}" cancellation
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${CUT}/${stage}: expected ${expected}, got ${result}\n${output}${error}\nRetained: ${work}")
  endif()
endfunction()
run_stage(init 0)
if(CUT MATCHES "lost_ack$")
  run_stage(crash 87)
else()
  run_stage(crash 86)
endif()
run_stage(inspect 0)
run_stage(recover 0)
run_stage(replay 0)
file(REMOVE_RECURSE "${work}")
