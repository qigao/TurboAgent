if(NOT DEFINED WORKER OR NOT EXISTS "${WORKER}" OR
   NOT DEFINED ROOT OR NOT IS_ABSOLUTE "${ROOT}" OR
   NOT CUT MATCHES "^delivery_(intent_(before|after|lost_ack|returned)|after_send|receipt_(before|after|lost_ack|returned))$")
  message(FATAL_ERROR "Invalid Job delivery crash case")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
if(NOT DEFINED MODE)
  set(MODE delivery)
elseif(NOT MODE STREQUAL "verified" AND NOT MODE STREQUAL "files")
  message(FATAL_ERROR "Unknown Job delivery mode")
endif()
set(work "${ROOT}/${MODE}-${CUT}-${nonce} with spaces")
file(MAKE_DIRECTORY "${work}")
function(run_stage stage expected)
  execute_process(COMMAND "${WORKER}" "${stage}" "${CUT}" "${work}" "${MODE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${CUT}/${stage}: expected ${expected}, got ${result}\n${output}${error}\nRetained: ${work}")
  endif()
endfunction()
run_stage(init 0)
if(CUT MATCHES "lost_ack$")
  run_stage(crash 87)
else()
  run_stage(crash 86)
endif()
run_stage(inspect 0)
run_stage(denied 0)
run_stage(stale 0)
if(MODE STREQUAL "verified" OR MODE STREQUAL "files")
  run_stage(verification_source_changed 0)
  run_stage(verification_evidence_missing 0)
  run_stage(verification_evidence_changed 0)
endif()
run_stage(recover 0)
run_stage(replay 0)
file(REMOVE_RECURSE "${work}")
