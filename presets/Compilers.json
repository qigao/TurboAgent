{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "Msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "AppleClang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "description": "Xcode compiler for native macOS and iOS SDKs"
        },
        {
            "name": "Clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "Gcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "GccMac",
            "hidden": true,
            "description": "Homebrew GNU GCC 15 for native Intel and Apple Silicon macOS builds",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc-15",
                "CMAKE_CXX_COMPILER": "g++-15"
            }
        },
        {
            "name": "RunnerClang",
            "hidden": true,
            "description": "Host native LLVM/Clang action-selected compiler without compiler-version checks",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "$env{LLVM_NATIVE_CC}",
                "CMAKE_CXX_COMPILER": "$env{LLVM_NATIVE_CXX}",
                "CMAKE_AR": "$env{LLVM_NATIVE_AR}",
                "CMAKE_RANLIB": "$env{LLVM_NATIVE_RANLIB}"
            }
        },
        {
            "name": "LlvmMingw",
            "hidden": true,
            "description": "Windows llvm-mingw/UCRT compiler (independent of MSVC)",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "$env{LLVM_MINGW_CC}",
                "CMAKE_CXX_COMPILER": "$env{LLVM_MINGW_CXX}",
                "CMAKE_TOOLCHAIN_FILE": "$env{QIGAO_VCPKG_TOOLCHAIN_FILE}"
            }
        }
    ]
}
